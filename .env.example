# ---------------------------------------------------------------------------
# TEMS Discovery Import Monitor - personal data / secrets
#
# Copy this file to ".env" and fill in your own values.
#   Copy-Item .env.example .env
#
# ".env" is listed in .gitignore and must NEVER be committed or shared.
# Values here override the same keys in config.json; real environment
# variables override this file.
# ---------------------------------------------------------------------------

# --- Identity used in the notification templates ---------------------------
DISPLAY_NAME=Your Name
SENDER_TITLE=Temsy

# --- Delivery channel: telegram | whatsapp | both --------------------------
CHANNEL=whatsapp

# --- WhatsApp via GREEN-API -------------------------------------------------
# Your own WhatsApp number in international format, digits only.
WHATSAPP_PHONE=201000000000
# GREEN-API instance ID and token (console.greenapi.com).
WHATSAPP_ID_INSTANCE=YOUR_INSTANCE_ID
WHATSAPP_API_TOKEN=YOUR_API_TOKEN
# Optional: leave blank to derive it from the first 4 digits of the instance ID
# (123456789012 -> https://1234.api.greenapi.com).
WHATSAPP_API_URL=
WHATSAPP_FALLBACK_API_URL=https://api.greenapi.com
# Optional explicit chat id ("201...@c.us"); blank = built from WHATSAPP_PHONE.
WHATSAPP_CHAT_ID=

# --- Remote control ---------------------------------------------------------
# Root folder used to infer the target project name.
REMOTE_ROOT=D:\WORK
# Extra allowed senders (digits only, comma separated). Your own number above
# is always allowed.
REMOTE_ALLOWED_PHONES=

# --- Telegram (only needed when CHANNEL includes telegram) ------------------
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- AI motivation messages (optional) --------------------------------------
# Without a key the monitor uses a built-in local message list.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openai/gpt-4o-mini
